Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # Networking
  config.vm.network "private_network", ip: "192.168.56.10"
  config.vm.network "public_network"

  # Sync local folder to VM
  config.vm.synced_folder "E:\\Devops\\Notes_website\\Client\\src\\pages", "/home/vagrant/site"

  # Provisioning
  config.vm.provision "shell", inline: <<-SHELL
    sudo apt-get update -y
    sudo apt-get install -y apache2 zip unzip

    # Replace default site with your files
    sudo rm -rf /var/www/html/*
    sudo cp -r /home/vagrant/site/* /var/www/html/

    # Set permissions
    sudo chown -R www-data:www-data /var/www/html
    sudo chmod -R 755 /var/www/html

    # Enable and start Apache
    sudo systemctl enable apache2
    sudo systemctl start apache2
  SHELL

  # VM resources
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
    vb.cpus = 2
  end
end
